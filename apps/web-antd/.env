# 应用标题
VITE_APP_TITLE=健身门店管理

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=jss-gym-admin

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

# 后端形态：v1（当前契约，默认）| yudao（芋道 Spring Boot 后端）
VITE_API_BACKEND=v1

# yudao 后台接口前缀（仅 VITE_API_BACKEND=yudao 时生效，网关需转发该前缀）
VITE_GLOB_YUDAO_ADMIN_PREFIX=/admin-api
